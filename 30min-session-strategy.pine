//@version=6
strategy("30分足切替前後戦略", overlay=true,
     default_qty_type=strategy.fixed, default_qty_value=1,
     process_orders_on_close=true)

// === 入力 ===
showTable  = input.bool(true, "レポートテーブル表示", group="レポート設定")
max_trades = input.int(30, "集計上限トレード数（各セッションごと）", minval=1, group="レポート設定")

// === セッション定義 (entry_h, entry_m, exit_h, exit_m, label) ===
var int N = 9
var array<int>    s_eh  = array.from(9, 9, 10, 10, 11, 12, 13, 14, 14)
var array<int>    s_em  = array.from(25, 55, 25, 55, 25, 55, 25, 25, 55)
var array<int>    s_xh  = array.from(9, 10, 10, 11, 12, 13, 14, 14, 15)
var array<int>    s_xm  = array.from(31, 1, 31, 1, 31, 1, 1, 31, 1)
var array<string> s_lbl = array.from(
     "S1(9:25-9:31)", "S2(9:55-10:01)", "S3(10:25-10:31)", "S4(10:55-11:01)",
     "S5(11:25-12:31)", "S6(12:55-13:01)", "S7(13:25-14:01)", "S8(14:25-14:31)",
     "S9(14:55-15:01)")

hhmm = hour * 100 + minute

// === 各セッションのエントリー発火フラグ ===
var array<bool> entryFired = array.new<bool>(N, false)

if timeframe.change("D")
    for i = 0 to N - 1
        array.set(entryFired, i, false)

// === 配列蓄積（セッション毎にフラット配列を用意：sess0, sess1, ... sess7） ===
var array<float> pnl0 = array.new<float>()
var array<float> pnl1 = array.new<float>()
var array<float> pnl2 = array.new<float>()
var array<float> pnl3 = array.new<float>()
var array<float> pnl4 = array.new<float>()
var array<float> pnl5 = array.new<float>()
var array<float> pnl6 = array.new<float>()
var array<float> pnl7 = array.new<float>()
var array<float> pnl8 = array.new<float>()

f_getArr(i) =>
    array<float> a = switch i
        0 => pnl0
        1 => pnl1
        2 => pnl2
        3 => pnl3
        4 => pnl4
        5 => pnl5
        6 => pnl6
        7 => pnl7
        => pnl8
    a

var float entryPrice = na

for i = 0 to N - 1
    eTime = array.get(s_eh, i) * 100 + array.get(s_em, i)
    xTime = array.get(s_xh, i) * 100 + array.get(s_xm, i)
    if hhmm == eTime and not array.get(entryFired, i)
        strategy.entry("S" + str.tostring(i), strategy.long)
        array.set(entryFired, i, true)
        entryPrice := close
    if hhmm == xTime and array.get(entryFired, i)
        strategy.close("S" + str.tostring(i))
        if not na(entryPrice)
            array.push(f_getArr(i), close - entryPrice)
            entryPrice := na
        array.set(entryFired, i, false)

// === 直近N件集計関数（戻り値に総数sizeも追加） ===
f_calc(pnl_arr, n) =>
    int   sz   = array.size(pnl_arr)
    int   bull = 0
    int   bear = 0
    float pnl  = 0.0
    if sz > 0
        int start_i = math.max(0, sz - n)
        for i = start_i to sz - 1
            float v = array.get(pnl_arr, i)
            pnl += v
            bull += v > 0 ? 1 : 0
            bear += v <= 0 ? 1 : 0
    [sz, bull, bear, pnl]

// === 集計結果保存 ===
var array<int>   dw_total = array.new<int>(N, 0)
var array<int>   dw_bull  = array.new<int>(N, 0)
var array<int>   dw_bear  = array.new<int>(N, 0)
var array<float> dw_pnl   = array.new<float>(N, 0.0)

if barstate.islastconfirmedhistory or barstate.islast
    for i = 0 to N - 1
        [sz, b, r, p] = f_calc(f_getArr(i), max_trades)
        array.set(dw_total, i, sz)
        array.set(dw_bull,  i, b)
        array.set(dw_bear,  i, r)
        array.set(dw_pnl,   i, p)

// === テーブル描画関数 ===
f_wr(bull, bear) =>
    total = bull + bear
    total > 0 ? str.tostring(float(bull) / float(total) * 100, "#.#") + "%" : "—"

f_row(tbl, row, lbl, raw_total, bull, bear, pnl, bg) =>
    table.cell(tbl, 0, row, lbl, bgcolor=bg, text_color=color.white, text_size=size.normal)
    table.cell(tbl, 1, row, str.tostring(raw_total), bgcolor=bg, text_color=color.white, text_size=size.normal)
    table.cell(tbl, 2, row, str.tostring(bull), bgcolor=bg, text_color=color.green, text_size=size.normal)
    table.cell(tbl, 3, row, str.tostring(bear), bgcolor=bg, text_color=color.red, text_size=size.normal)
    table.cell(tbl, 4, row, f_wr(bull, bear), bgcolor=bg, text_color=color.white, text_size=size.normal)
    table.cell(tbl, 5, row, str.tostring(pnl, "#,###.##"), bgcolor=bg, text_color = pnl >= 0 ? color.green : color.red, text_size=size.normal)

// === メイン表（列数6） ===
var table mainTable = table.new(position.top_right, 6, N + 12,
     bgcolor=color.new(color.gray, 90), border_width=1,
     frame_color=color.gray, border_color=color.new(color.gray, 60))

if showTable and (barstate.islastconfirmedhistory or barstate.islast)
    color C_HDR = color.new(#1e88e5, 0)
    table.cell(mainTable, 0, 0, "セッション",   bgcolor=C_HDR, text_color=color.white, text_size=size.normal)
    table.cell(mainTable, 1, 0, "総数",         bgcolor=C_HDR, text_color=color.white, text_size=size.normal)
    table.cell(mainTable, 2, 0, "勝",           bgcolor=C_HDR, text_color=color.white, text_size=size.normal)
    table.cell(mainTable, 3, 0, "負",           bgcolor=C_HDR, text_color=color.white, text_size=size.normal)
    table.cell(mainTable, 4, 0, "勝率",         bgcolor=C_HDR, text_color=color.white, text_size=size.normal)
    table.cell(mainTable, 5, 0, "PnL合計",      bgcolor=C_HDR, text_color=color.white, text_size=size.normal)

    int row = 1
    color C_AM = color.new(#1b5e20, 30)
    int   sum_total = 0
    int   sum_bull  = 0
    int   sum_bear  = 0
    float sum_pnl   = 0.0

    for i = 0 to N - 1
        t = array.get(dw_total, i)
        b = array.get(dw_bull,  i)
        r = array.get(dw_bear,  i)
        p = array.get(dw_pnl,   i)
        f_row(mainTable, row, array.get(s_lbl, i), t, b, r, p, C_AM)
        sum_total += t
        sum_bull  += b
        sum_bear  += r
        sum_pnl   += p
        row += 1

    f_row(mainTable, row, "Sum", sum_total, sum_bull, sum_bear, sum_pnl, C_AM)
    row += 1

    color C_STATS = color.new(#4a148c, 30)
    for c = 0 to 5
        table.cell(mainTable, c, row, c == 0 ? "Strategy Stats" : "", bgcolor=color.new(#455a64, 0), text_color=color.white, text_size=size.normal)
    row += 1

    int   total_trades  = sum_bull + sum_bear
    float win_rate      = total_trades > 0 ? float(sum_bull) / float(total_trades) * 100 : 0.0
    float max_dd_amount = strategy.max_drawdown
    float max_dd_pct    = strategy.initial_capital > 0 ? (strategy.max_drawdown / strategy.initial_capital) * 100 : na
    float pf            = strategy.grossloss != 0 ? strategy.grossprofit / math.abs(strategy.grossloss) : na

    table.cell(mainTable, 0, row, "Net Profit", bgcolor=C_STATS, text_color=color.white, text_size=size.normal)
    table.cell(mainTable, 1, row, str.tostring(strategy.netprofit, "#,###.##"), bgcolor=C_STATS, text_color = strategy.netprofit >= 0 ? color.green : color.red, text_size=size.normal)
    row += 1
    table.cell(mainTable, 0, row, "Gross Profit", bgcolor=C_STATS, text_color=color.white, text_size=size.normal)
    table.cell(mainTable, 1, row, str.tostring(strategy.grossprofit, "#,###.##"), bgcolor=C_STATS, text_color=color.white, text_size=size.normal)
    row += 1
    table.cell(mainTable, 0, row, "Gross Loss", bgcolor=C_STATS, text_color=color.white, text_size=size.normal)
    table.cell(mainTable, 1, row, str.tostring(strategy.grossloss, "#,###.##"), bgcolor=C_STATS, text_color=color.white, text_size=size.normal)
    row += 1
    table.cell(mainTable, 0, row, "Profit Factor", bgcolor=C_STATS, text_color=color.white, text_size=size.normal)
    table.cell(mainTable, 1, row, na(pf) ? "—" : str.tostring(pf, "#.##"), bgcolor=C_STATS, text_color = pf >= 1.5 ? color.green : (pf >= 1.0 ? color.orange : color.red), text_size=size.normal)
    row += 1
    table.cell(mainTable, 0, row, "Win Rate %", bgcolor=C_STATS, text_color=color.white, text_size=size.normal)
    table.cell(mainTable, 1, row, str.tostring(win_rate, "#.##") + "%", bgcolor=C_STATS, text_color = win_rate >= 50 ? color.green : color.red, text_size=size.normal)
    row += 1
    table.cell(mainTable, 0, row, "Total Trades", bgcolor=C_STATS, text_color=color.white, text_size=size.normal)
    table.cell(mainTable, 1, row, str.tostring(total_trades), bgcolor=C_STATS, text_color=color.white, text_size=size.normal)
    row += 1
    table.cell(mainTable, 0, row, "Max Drawdown %", bgcolor=C_STATS, text_color=color.white, text_size=size.normal)
    table.cell(mainTable, 1, row, na(max_dd_pct) ? "—" : str.tostring(max_dd_pct, "#.##") + "%", bgcolor=C_STATS, text_color=color.white, text_size=size.normal)
    row += 1
    table.cell(mainTable, 0, row, "Max Drawdown (金額)", bgcolor=C_STATS, text_color=color.white, text_size=size.normal)
    table.cell(mainTable, 1, row, str.tostring(max_dd_amount, "#,###.##"), bgcolor=C_STATS, text_color=color.white, text_size=size.normal)
    row += 1
    float dd_profit_ratio = strategy.netprofit != 0 ? (max_dd_amount / strategy.netprofit) * 100 : na
    table.cell(mainTable, 0, row, "DD/Profit Ratio", bgcolor=C_STATS, text_color=color.white, text_size=size.normal)
    table.cell(mainTable, 1, row, na(dd_profit_ratio) ? "—" : str.tostring(dd_profit_ratio, "#.##") + "%",
               bgcolor=C_STATS,
               text_color = na(dd_profit_ratio) ? color.white : strategy.netprofit <= 0 ? color.red : dd_profit_ratio > 50 ? color.red : dd_profit_ratio > 30 ? color.orange : color.green,
               text_size=size.normal)

// === データウィンドウ出力（スクレイピング用） ===
f_dw_wr(bull, bear) => bull + bear > 0 ? float(bull) / float(bull + bear) * 100 : na

t0 = array.get(dw_total, 0), b0 = array.get(dw_bull, 0), r0 = array.get(dw_bear, 0), p0 = array.get(dw_pnl, 0)
t1 = array.get(dw_total, 1), b1 = array.get(dw_bull, 1), r1 = array.get(dw_bear, 1), p1 = array.get(dw_pnl, 1)
t2 = array.get(dw_total, 2), b2 = array.get(dw_bull, 2), r2 = array.get(dw_bear, 2), p2 = array.get(dw_pnl, 2)
t3 = array.get(dw_total, 3), b3 = array.get(dw_bull, 3), r3 = array.get(dw_bear, 3), p3 = array.get(dw_pnl, 3)
t4 = array.get(dw_total, 4), b4 = array.get(dw_bull, 4), r4 = array.get(dw_bear, 4), p4 = array.get(dw_pnl, 4)
t5 = array.get(dw_total, 5), b5 = array.get(dw_bull, 5), r5 = array.get(dw_bear, 5), p5 = array.get(dw_pnl, 5)
t6 = array.get(dw_total, 6), b6 = array.get(dw_bull, 6), r6 = array.get(dw_bear, 6), p6 = array.get(dw_pnl, 6)
t7 = array.get(dw_total, 7), b7 = array.get(dw_bull, 7), r7 = array.get(dw_bear, 7), p7 = array.get(dw_pnl, 7)
t8 = array.get(dw_total, 8), b8 = array.get(dw_bull, 8), r8 = array.get(dw_bear, 8), p8 = array.get(dw_pnl, 8)

plot(t0, title="S1 総数", display=display.data_window)
plot(b0, title="S1 勝",   display=display.data_window)
plot(r0, title="S1 負",   display=display.data_window)
plot(f_dw_wr(b0, r0), title="S1 勝率%", display=display.data_window)
plot(p0, title="S1 PnL", display=display.data_window)

plot(t1, title="S2 総数", display=display.data_window)
plot(b1, title="S2 勝",   display=display.data_window)
plot(r1, title="S2 負",   display=display.data_window)
plot(f_dw_wr(b1, r1), title="S2 勝率%", display=display.data_window)
plot(p1, title="S2 PnL", display=display.data_window)

plot(t2, title="S3 総数", display=display.data_window)
plot(b2, title="S3 勝",   display=display.data_window)
plot(r2, title="S3 負",   display=display.data_window)
plot(f_dw_wr(b2, r2), title="S3 勝率%", display=display.data_window)
plot(p2, title="S3 PnL", display=display.data_window)

plot(t3, title="S4 総数", display=display.data_window)
plot(b3, title="S4 勝",   display=display.data_window)
plot(r3, title="S4 負",   display=display.data_window)
plot(f_dw_wr(b3, r3), title="S4 勝率%", display=display.data_window)
plot(p3, title="S4 PnL", display=display.data_window)

plot(t4, title="S5 総数", display=display.data_window)
plot(b4, title="S5 勝",   display=display.data_window)
plot(r4, title="S5 負",   display=display.data_window)
plot(f_dw_wr(b4, r4), title="S5 勝率%", display=display.data_window)
plot(p4, title="S5 PnL", display=display.data_window)

plot(t5, title="S6 総数", display=display.data_window)
plot(b5, title="S6 勝",   display=display.data_window)
plot(r5, title="S6 負",   display=display.data_window)
plot(f_dw_wr(b5, r5), title="S6 勝率%", display=display.data_window)
plot(p5, title="S6 PnL", display=display.data_window)

plot(t6, title="S7 総数", display=display.data_window)
plot(b6, title="S7 勝",   display=display.data_window)
plot(r6, title="S7 負",   display=display.data_window)
plot(f_dw_wr(b6, r6), title="S7 勝率%", display=display.data_window)
plot(p6, title="S7 PnL", display=display.data_window)

plot(t7, title="S8 総数", display=display.data_window)
plot(b7, title="S8 勝",   display=display.data_window)
plot(r7, title="S8 負",   display=display.data_window)
plot(f_dw_wr(b7, r7), title="S8 勝率%", display=display.data_window)
plot(p7, title="S8 PnL", display=display.data_window)

plot(t8, title="S9 総数", display=display.data_window)
plot(b8, title="S9 勝",   display=display.data_window)
plot(r8, title="S9 負",   display=display.data_window)
plot(f_dw_wr(b8, r8), title="S9 勝率%", display=display.data_window)
plot(p8, title="S9 PnL", display=display.data_window)

sum_total_dw = t0+t1+t2+t3+t4+t5+t6+t7+t8
sum_bull_dw  = b0+b1+b2+b3+b4+b5+b6+b7+b8
sum_bear_dw  = r0+r1+r2+r3+r4+r5+r6+r7+r8
sum_pnl_dw   = p0+p1+p2+p3+p4+p5+p6+p7+p8

plot(sum_total_dw, title="Sum 総数", display=display.data_window)
plot(sum_bull_dw,  title="Sum 勝",   display=display.data_window)
plot(sum_bear_dw,  title="Sum 負",   display=display.data_window)
plot(f_dw_wr(sum_bull_dw, sum_bear_dw), title="Sum 勝率%", display=display.data_window)
plot(sum_pnl_dw,   title="Sum PnL",  display=display.data_window)
